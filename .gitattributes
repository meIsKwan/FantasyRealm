# Unreal Engine 5 .gitattributes

# Auto detect text files and normalize line endings
* text=auto

# =====================
# Source code
# =====================
*.cs text diff
*.cpp text diff
*.h text diff
*.hpp text diff
*.c text diff
*.cc text diff
*.cxx text diff
*.py text diff
*.js text diff
*.json text diff
*.xml text diff
*.ini text diff
*.cfg text diff
*.yaml text diff
*.yml text diff
*.md text diff
*.txt text diff

# Unreal Engine files
*.uplugin text diff
*.uproject text diff

# Shader files
*.usf text diff
*.ush text diff
*.hlsl text diff
*.glsl text diff

# Build files
*.cs_proj text diff
*.sln text diff
*.csproj text diff
*.target text diff

# =====================
# Git LFS - Unreal assets
# =====================
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
